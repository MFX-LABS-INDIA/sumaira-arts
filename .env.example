# =========================================================================
# Sumaira Arts - Environment Variables Template
# Copy this file to .env.local and replace the placeholder values
# =========================================================================

# Public site URL (required for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin Notification Email (CC'd on every customer order)
ADMIN_EMAIL_CC=admin@sumairaarts.com

# SMTP Mail Server Settings (Zoho / Gmail / Custom SMTP)
# - Host: e.g. smtp.zoho.com or smtp.gmail.com
# - Port: 465 (SSL) or 587 (TLS)
# - User: Your full sending email address
# - Pass: Your email password or App Password (recommended with 2FA)
# - From Name: The display sender name
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=orders@sumairaarts.com
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM_NAME="Sumaira Arts Studio"

# Google Sheets Database Configuration
# - Sheets ID: The ID extracted from your Google Sheets URL
#   (https://docs.google.com/spreadsheets/d/{GOOGLE_SHEETS_ID}/edit)
# - Client Email: The Google Cloud service account email (...@...iam.gserviceaccount.com)
# - Private Key: The service account private key (keep in quotes with \n)
GOOGLE_SHEETS_ID=your-google-sheets-id-from-url
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_DETAILS_GO_HERE\n-----END PRIVATE KEY-----\n"
